# Copy to .env.local and fill in values. Never commit .env.local.

# Cloud SQL PostgreSQL 15 (asia-south1)
DATABASE_URL=postgresql://USER:PASS@/crm?host=/cloudsql/PROJECT:REGION:INSTANCE

# NextAuth
NEXTAUTH_SECRET=replace-with-32-random-bytes
NEXTAUTH_URL=https://crm.nobroker.in

# Google OAuth (NoBroker Workspace)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domain restriction
ALLOWED_DOMAIN=nobroker.in

# Google Sheets spreadsheet IDs
SHEETS_SPREADSHEET_ID_SOCIETY=
SHEETS_SPREADSHEET_ID_BUYER=

# Google Service Account JSON — for Sheets API + Cloud SQL
# Paste the entire JSON as a single-line string
GOOGLE_SERVICE_ACCOUNT_KEY=

# Timezone (also set in Cloud Run)
TZ=Asia/Kolkata
